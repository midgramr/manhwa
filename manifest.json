{
  "manifest_version": 2,
  "name": "Image Replacer",
  "version": "1.0",
  "permissions": [
    "<all_urls>",
    "http://127.0.0.1:8080/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    "page-hook.js"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "image-replacer@example.com"
    }
  }
}